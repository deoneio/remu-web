{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/layout/**",
              "components/media/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|Schibsted Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, Schibsted Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddressBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:city|lines|phone|mapHref|mapLabel|style|key|ref|className|style|children)$/]",
        "message": "<AddressBlock> doesn't accept that prop. Declared props: city, lines, phone, mapHref, mapLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchClusterItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|tint|shape|width|height|offsetY|key|ref|className|style|children)$/]",
        "message": "<ArchClusterItem> doesn't accept that prop. Declared props: src, alt, caption, tint, shape, width, height, offsetY."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchClusterItem'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:arch|capsule|square)$/]",
        "message": "<ArchClusterItem> shape must be one of 'arch' | 'capsule' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchMedia'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|shape|width|height|offsetY|tint|caption|style|key|ref|className|style|children)$/]",
        "message": "<ArchMedia> doesn't accept that prop. Declared props: src, alt, shape, width, height, offsetY, tint, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchMedia'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:arch|capsule|square)$/]",
        "message": "<ArchMedia> shape must be one of 'arch' | 'capsule' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|direction|size|underline|tone|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: children, href, direction, size, underline, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:diagonal|chevron|up|down)$/]",
        "message": "<ArrowLink> direction must be one of 'diagonal' | 'chevron' | 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md)$/]",
        "message": "<ArrowLink> size must be one of 'xs' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted|inverse)$/]",
        "message": "<ArrowLink> tone must be one of 'default' | 'muted' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|size|tone|href|style|key|ref|className|style|children)$/]",
        "message": "<BrandBadge> doesn't accept that prop. Declared props: initials, size, tone, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|ink|paper)$/]",
        "message": "<BrandBadge> tone must be one of 'neutral' | 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|href|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, href, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|quiet|inverse)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'quiet' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:none|chevron|diagonal|up)$/]",
        "message": "<Button> icon must be one of 'none' | 'chevron' | 'diagonal' | 'up'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnRules'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|from|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<ColumnRules> doesn't accept that prop. Declared props: count, from, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnRules'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:hairline|strong)$/]",
        "message": "<ColumnRules> tone must be one of 'hairline' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:wordmark|socialLabel|social|languages|action|onAction|offices|legal|copyright|topLabel|onTop|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: wordmark, socialLabel, social, languages, action, onAction, offices, legal, copyright, topLabel, onTop, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|tone|mono|size|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children, as, tone, mono, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted|subtle|inverse)$/]",
        "message": "<Label> tone must be one of 'default' | 'muted' | 'subtle' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:micro|label|small)$/]",
        "message": "<Label> size must be one of 'micro' | 'label' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:languages|value|onChange|tone|style|key|ref|className|style|children)$/]",
        "message": "<LangToggle> doesn't accept that prop. Declared props: languages, value, onChange, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangToggle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inverse)$/]",
        "message": "<LangToggle> tone must be one of 'default' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|height|tint|scrim|children|style|key|ref|className|style|children)$/]",
        "message": "<MediaBand> doesn't accept that prop. Declared props: src, alt, height, tint, scrim, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaBand'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:none|top|bottom)$/]",
        "message": "<MediaBand> scrim must be one of 'none' | 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|onClick|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|measure|align|tone|as|style|key|ref|className|style|children)$/]",
        "message": "<Statement> doesn't accept that prop. Declared props: children, size, measure, align, tone, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|lead|body)$/]",
        "message": "<Statement> size must be one of 'display' | 'lead' | 'body'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Statement> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted|inverse)$/]",
        "message": "<Statement> tone must be one of 'default' | 'muted' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|size|weight|align|tone|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: children, as, size, weight, align, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Wordmark> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|inverse)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'inverse'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
